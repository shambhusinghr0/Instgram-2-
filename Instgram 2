
name: Instgram 2 Android APK

"on":
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Flutter
        uses: subosito/flutter-action@v2
        with:
          channel: stable

      - name: Extract ZIP
        run: |
          mkdir source
          unzip Instgram2_Starter_Project.zip -d source

      - name: Create Flutter project
        run: |
          flutter create --platforms=android --project-name instgram2 app
          cp source/lib/main.dart app/lib/main.dart
          cp source/pubspec.yaml app/pubspec.yaml

      - name: Build APK
        run: |
          cd app
          flutter pub get
          flutter build apk --release

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: Instgram2-APK
          path: app/build/app/outputs/flutter-apk/app-release.apk
